# ───────────────────────────────────────────
# 영희네 작업실 · 환경변수 가이드
# 실제 값은 .env.local 에 채울 것 (gitignore)
# ───────────────────────────────────────────

# NextAuth (Auth.js v5)
# - openssl rand -base64 32 로 생성
AUTH_SECRET=changeme
AUTH_URL=http://localhost:3324

# Firebase Admin (Service Account)
# - Firebase Console → 프로젝트 설정 → 서비스 계정 → 새 비공개 키 생성
# - 다운받은 JSON 전체를 한 줄로 압축해서 넣기 (개행 X)
#   tip: cat key.json | jq -c .
FIREBASE_SERVICE_ACCOUNT_KEY={}

# Y / H 시드 계정
# bcrypt 해시는 $ 기호 때문에 dotenv-expand가 변수로 잘못 해석함.
# → base64 인코딩해서 SEED_*_PASSWORD_HASH_B64 로 저장.
#   생성:
#     HASH=$(node -e "console.log(require('bcryptjs').hashSync('너의비번',10))")
#     echo -n "$HASH" | base64
#
# LOGIN_ID는 로그인 시 입력할 아이디 (대소문자 무시, Y/H도 같이 허용)
SEED_Y_ID=Y
SEED_Y_LOGIN_ID=daeyoung
SEED_Y_PASSWORD_HASH_B64=
SEED_Y_EMAIL=

SEED_H_ID=H
SEED_H_LOGIN_ID=heeseo
SEED_H_PASSWORD_HASH_B64=
SEED_H_EMAIL=

# 앱 URL (구글 OAuth 콜백 redirect_uri 등에 사용)
NEXT_PUBLIC_APP_URL=http://localhost:3324

# Google OAuth (선택)
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
# Authorized redirect URIs:
#   http://localhost:3324/api/auth/callback/google
#   https://<프로덕션 도메인>/api/auth/callback/google
# 두 값이 모두 있어야 /login·/admin/account 의 구글 연동 활성화됨
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
