# ───────────────────────────────────────────
# 영희네 작업실 · 환경변수 가이드
# 실제 값은 .env.local 에 채울 것 (gitignore 대상)
# ───────────────────────────────────────────

# NextAuth (Auth.js v5)
# - openssl rand -base64 32 로 생성
AUTH_SECRET=changeme
# - 배포 시 https URL, 로컬은 자동 감지 (선택)
AUTH_URL=http://localhost:3324

# Firebase Admin (Service Account)
# - Firebase Console → 프로젝트 설정 → 서비스 계정 → 새 비공개 키 생성
# - 다운받은 JSON 전체를 한 줄로 압축해서 넣기 (개행 X)
FIREBASE_SERVICE_ACCOUNT_KEY={}

# Firebase 클라이언트 (필요 시. 일단 Admin만 사용)
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=

# Y / H 초기 계정 (시드 데이터, bcrypt 해시)
# - bcrypt 라운드 10 권장
# - 생성: node -e "console.log(require('bcryptjs').hashSync('패스워드',10))"
SEED_Y_ID=y
SEED_Y_PASSWORD_HASH=
SEED_Y_EMAIL=

SEED_H_ID=h
SEED_H_PASSWORD_HASH=
SEED_H_EMAIL=

# AI (Phase 3에서 사용 — 키워드 생성)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Whisper (Phase 4 — 독서모임 음성→텍스트)
# OPENAI_API_KEY 와 동일

# 앱 URL (구글 OAuth 콜백 redirect_uri 등에 사용)
NEXT_PUBLIC_APP_URL=http://localhost:3324
