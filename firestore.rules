rules_version = '2';

// 영희네 작업실 Firestore 보안 규칙
//
// 정책: 모든 데이터 접근은 Next.js API routes를 통해서만 (Admin SDK 사용).
// Admin SDK는 이 규칙을 우회하므로, 여기서는 클라이언트 직접 접근을 전면 차단한다.
//
// 추후 클라 SDK를 도입할 경우 컬렉션별 세분화 (read public, write Y/H only 등).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
